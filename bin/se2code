#!/usr/bin/env bash
# ==============================================================================
# se2Code Stack Server - CLI de Control Interactivo
# ==============================================================================
set -euo pipefail

# Localizar la raíz del stack
if [ -L "$0" ]; then
    REAL_SCRIPT=$(readlink -f "$0")
else
    REAL_SCRIPT="$0"
fi
STACK_ROOT="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"

# Soporte para subcomandos directos por línea de comandos (CLI)
if [ $# -gt 0 ]; then
    case "$1" in
        replace-urls)
            shift
            bash "$STACK_ROOT/modules/wordpress/scripts/replace-urls.sh" "$@"
            exit $?
            ;;
        optimize|optimize-site)
            shift
            bash "$STACK_ROOT/modules/wordpress/scripts/optimize-site.sh" "$@"
            exit $?
            ;;
        switch-php)
            shift
            bash "$STACK_ROOT/modules/wordpress/scripts/switch-php.sh" "$@"
            exit $?
            ;;
        list|list-sites)
            shift
            bash "$STACK_ROOT/modules/wordpress/scripts/list-sites.sh" "$@"
            exit $?
            ;;
        backup)
            shift
            bash "$STACK_ROOT/modules/wordpress/scripts/backup-site.sh" "$@"
            exit $?
            ;;
        purge-cache)
            sudo rm -rf /var/cache/nginx/* 2>/dev/null || true
            docker exec wp-nginx rm -rf /var/cache/nginx/* 2>/dev/null || true
            docker exec redis redis-cli FLUSHALL >/dev/null 2>&1 || true
            docker exec wp-nginx nginx -s reload 2>/dev/null || true
            echo "Caché FastCGI y memoria Redis vaciados."
            exit 0
            ;;
    esac
fi

# Cargar utilidades
source "$STACK_ROOT/core/banner.sh"
source "$STACK_ROOT/core/hardware.sh"
[ -f "$STACK_ROOT/core/swap.sh" ] && source "$STACK_ROOT/core/swap.sh"

while true; do
    show_banner
    
    # 1. Resumen de estado de WordPress
    WP_SITES_COUNT=$(find "$STACK_ROOT/modules/wordpress/nginx/conf.d" -type f -name "*.conf" ! -name "default*.conf" 2>/dev/null | wc -l | tr -d ' ')
    
    # 2. Detección en vivo de WireGuard VPN
    WG_RUNNING=false
    if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^wireguard$" && [ -f "$STACK_ROOT/modules/wireguard/config/peer1/peer1.conf" ]; then
        WG_RUNNING=true
    fi

    # Barra de estado dinámica
    STATUS_LINE="  ${C_BOLD}ESTADO:${C_RESET} Sitios WordPress: ${C_GREEN}${WP_SITES_COUNT}${C_RESET} | NGINX: ${C_GREEN}Activo${C_RESET} | MariaDB: ${C_GREEN}Activa${C_RESET}"
    if [ "$WG_RUNNING" = true ]; then
        STATUS_LINE="${STATUS_LINE} | VPN: ${C_GREEN}Activo ✔${C_RESET}"
    fi
    echo -e "$STATUS_LINE"
    echo -e "${C_CYAN}================================================================${C_RESET}"

    # Menú de WordPress
    echo -e "  ${C_BOLD}${C_CYAN}[ GESTIÓN DE WORDPRESS ]${C_RESET}"
    echo -e "  1) 📋 Listar todos los sitios WordPress instalados"
    echo -e "  2) ➕ Crear nuevo sitio WordPress (Desde cero / Descarga oficial)"
    echo -e "  3) 📥 Migrar / Importar Sitio Existente (.tar.gz + .sql + search-replace)"
    echo -e "  4) 🌍 Agregar sub-sitio / idioma a un sitio existente (ej: /es, /en)"
    echo -e "  5) 🗑️  Eliminar un sitio (con backup automático previo)"
    echo -e "  6) 🔄 Cambiar versión de PHP de un sitio (8.4 ↔ 8.5)"
    echo -e "  7) 🔑 Actualizar / Pegar Certificados SSL de Cloudflare"
    echo -e "  8) 💾 Respaldos Granulares (Base de datos, Archivos o Full)"
    echo -e "  9) 🧹 Purgar Cachés del Servidor (FastCGI Cache + Redis)"
    echo -e " 10) 🚀 Optimizar Sitio Existente (Redis + Nginx Helper + Anti-Conflictos)"
    echo -e " 11) 🔗 Reemplazo Canónico de URLs (4 Variantes ➔ 1 Sola URL & Elementor)"
    echo -e ""

    # Menú condicional de WireGuard
    if [ "$WG_RUNNING" = true ]; then
        echo -e "  ${C_BOLD}${C_CYAN}[ GESTIÓN DE WIREGUARD VPN (Activo ✔) ]${C_RESET}"
        echo -e " 12) 📱 Mostrar Código QR para Celular (Peer 1)"
        echo -e " 13) 👥 Ver conexiones activas y estado del túnel"
        echo -e " 14) ⏹️  Detener WireGuard VPN"
        echo -e ""
        echo -e "  ${C_BOLD}${C_CYAN}[ SISTEMA Y RENDIMIENTO ]${C_RESET}"
        echo -e " 15) 📊 Diagnóstico de Hardware y Memoria en vivo"
        echo -e " 16) 🛡️  Activar / Ajustar Escudo de Memoria Swap"
        echo -e " 17) ❌ Salir"
        echo -e "${C_CYAN}================================================================${C_RESET}"

        read -r -p "Selecciona una opción [1-17]: " MENU_CHOICE

        case "$MENU_CHOICE" in
            1)
                bash "$STACK_ROOT/modules/wordpress/scripts/list-sites.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            2)
                bash "$STACK_ROOT/modules/wordpress/scripts/add-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            3)
                bash "$STACK_ROOT/modules/wordpress/scripts/migrate-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            4)
                bash "$STACK_ROOT/modules/wordpress/scripts/add-subsite.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            5)
                bash "$STACK_ROOT/modules/wordpress/scripts/remove-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            6)
                bash "$STACK_ROOT/modules/wordpress/scripts/switch-php.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            7)
                echo -e "\n${C_BOLD}--- Actualización de Certificados SSL ---${C_RESET}"
                read -r -p "Escribe el dominio exacto (ej: misitio.com): " DOM
                CERTS_DIR="$STACK_ROOT/modules/wordpress/nginx/certs/$DOM"
                mkdir -p "$CERTS_DIR"
                
                echo -e "\n${C_CYAN}Pega el Certificado de Origen (Origin Certificate) y escribe 'EOF' al terminar:${C_RESET}"
                SSL_CERT=""
                while IFS= read -r line; do
                    [ "$line" = "EOF" ] && break
                    SSL_CERT="${SSL_CERT}${line}\n"
                done
                printf "%b" "$SSL_CERT" > "$CERTS_DIR/fullchain.pem"

                echo -e "\n${C_CYAN}Pega la Llave Privada (Private Key) y escribe 'EOF' al terminar:${C_RESET}"
                SSL_KEY=""
                while IFS= read -r line; do
                    [ "$line" = "EOF" ] && break
                    SSL_KEY="${SSL_KEY}${line}\n"
                done
                printf "%b" "$SSL_KEY" > "$CERTS_DIR/privkey.pem"
                cp "$CERTS_DIR/fullchain.pem" "$CERTS_DIR/chain.pem"
                chmod 600 "$CERTS_DIR/privkey.pem"
                chmod 644 "$CERTS_DIR"/*.pem
                docker exec wp-nginx nginx -s reload 2>/dev/null || true
                log_ok "Certificados actualizados y NGINX recargado."
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            8)
                bash "$STACK_ROOT/modules/wordpress/scripts/backup-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            9)
                log_step "Purgando Caché FastCGI y Redis..."
                sudo rm -rf /var/cache/nginx/* 2>/dev/null || true
                docker exec wp-nginx rm -rf /var/cache/nginx/* 2>/dev/null || true
                docker exec redis redis-cli FLUSHALL >/dev/null 2>&1 || true
                docker exec wp-nginx nginx -s reload 2>/dev/null || true
                log_ok "Caché de páginas FastCGI y memoria Redis vaciados por completo."
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            10)
                bash "$STACK_ROOT/modules/wordpress/scripts/optimize-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            11)
                bash "$STACK_ROOT/modules/wordpress/scripts/replace-urls.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            12)
                echo -e "\n${C_BOLD}${C_GREEN}📱 Código QR de WireGuard (Peer 1 Móvil):${C_RESET}\n"
                qrencode -t ansiutf8 < "$STACK_ROOT/modules/wireguard/config/peer1/peer1.conf"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            13)
                echo -e "\n${C_BOLD}--- Conexiones Activas de WireGuard VPN ---${C_RESET}"
                docker exec wireguard wg show 2>/dev/null || log_warn "El contenedor de WireGuard no está corriendo."
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            14)
                log_step "Deteniendo servicio WireGuard VPN..."
                docker compose -f "$STACK_ROOT/modules/wireguard/docker-compose.yml" down >/dev/null 2>&1 || docker stop wireguard >/dev/null 2>&1 || true
                log_ok "WireGuard VPN detenido."
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            15)
                show_hardware_diagnostics
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            16)
                create_swap_shield 2
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            17|q|Q)
                echo -e "\n${C_CYAN}¡Hasta pronto! Gracias por usar se2Code Stack.${C_RESET}\n"
                exit 0
                ;;
            *)
                log_warn "Opción inválida."
                sleep 1
                ;;
        esac
    else
        echo -e "  ${C_BOLD}${C_CYAN}[ MÓDULOS OPCIONALES ]${C_RESET}"
        echo -e " 12) 🛡️  Instalar y Configurar WireGuard VPN"
        echo -e ""
        echo -e "  ${C_BOLD}${C_CYAN}[ SISTEMA Y RENDIMIENTO ]${C_RESET}"
        echo -e " 13) 📊 Diagnóstico de Hardware y Memoria en vivo"
        echo -e " 14) 🛡️  Activar / Ajustar Escudo de Memoria Swap"
        echo -e " 15) ❌ Salir"
        echo -e "${C_CYAN}================================================================${C_RESET}"

        read -r -p "Selecciona una opción [1-15]: " MENU_CHOICE

        case "$MENU_CHOICE" in
            1)
                bash "$STACK_ROOT/modules/wordpress/scripts/list-sites.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            2)
                bash "$STACK_ROOT/modules/wordpress/scripts/add-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            3)
                bash "$STACK_ROOT/modules/wordpress/scripts/migrate-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            4)
                bash "$STACK_ROOT/modules/wordpress/scripts/add-subsite.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            5)
                bash "$STACK_ROOT/modules/wordpress/scripts/remove-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            6)
                bash "$STACK_ROOT/modules/wordpress/scripts/switch-php.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            7)
                echo -e "\n${C_BOLD}--- Actualización de Certificados SSL ---${C_RESET}"
                read -r -p "Escribe el dominio exacto (ej: misitio.com): " DOM
                CERTS_DIR="$STACK_ROOT/modules/wordpress/nginx/certs/$DOM"
                mkdir -p "$CERTS_DIR"
                
                echo -e "\n${C_CYAN}Pega el Certificado de Origen (Origin Certificate) y escribe 'EOF' al terminar:${C_RESET}"
                SSL_CERT=""
                while IFS= read -r line; do
                    [ "$line" = "EOF" ] && break
                    SSL_CERT="${SSL_CERT}${line}\n"
                done
                printf "%b" "$SSL_CERT" > "$CERTS_DIR/fullchain.pem"

                echo -e "\n${C_CYAN}Pega la Llave Privada (Private Key) y escribe 'EOF' al terminar:${C_RESET}"
                SSL_KEY=""
                while IFS= read -r line; do
                    [ "$line" = "EOF" ] && break
                    SSL_KEY="${SSL_KEY}${line}\n"
                done
                printf "%b" "$SSL_KEY" > "$CERTS_DIR/privkey.pem"
                cp "$CERTS_DIR/fullchain.pem" "$CERTS_DIR/chain.pem"
                chmod 600 "$CERTS_DIR/privkey.pem"
                chmod 644 "$CERTS_DIR"/*.pem
                docker exec wp-nginx nginx -s reload 2>/dev/null || true
                log_ok "Certificados actualizados y NGINX recargado."
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            8)
                bash "$STACK_ROOT/modules/wordpress/scripts/backup-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            9)
                log_step "Purgando Caché FastCGI y Redis..."
                sudo rm -rf /var/cache/nginx/* 2>/dev/null || true
                docker exec wp-nginx rm -rf /var/cache/nginx/* 2>/dev/null || true
                docker exec redis redis-cli FLUSHALL >/dev/null 2>&1 || true
                docker exec wp-nginx nginx -s reload 2>/dev/null || true
                log_ok "Caché de páginas FastCGI y memoria Redis vaciados por completo."
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            10)
                bash "$STACK_ROOT/modules/wordpress/scripts/optimize-site.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            11)
                bash "$STACK_ROOT/modules/wordpress/scripts/replace-urls.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            12)
                bash "$STACK_ROOT/modules/wireguard/setup-vpn.sh"
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            13)
                show_hardware_diagnostics
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            14)
                create_swap_shield 2
                read -r -p "Presiona ENTER para volver al menú..." _
                ;;
            15|q|Q)
                echo -e "\n${C_CYAN}¡Hasta pronto! Gracias por usar se2Code Stack.${C_RESET}\n"
                exit 0
                ;;
            *)
                log_warn "Opción inválida."
                sleep 1
                ;;
        esac
    fi
done
